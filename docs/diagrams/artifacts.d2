vars: {
  d2-config: {
    layout-engine: dagre
    pad: 0
  }
  colors: {
    design: "#e3f2fd"
    design-border: "#1976D2"
    impl: "#f5f5f5"
    impl-border: "#9e9e9e"
    qa: "#f3e5f5"
    qa-border: "#7B1FA2"
    archive: "#e8f5e9"
    archive-border: "#388E3C"
    feedback: "#fff3e0"
    feedback-border: "#FF9800"
    lc: "#555555"
  }
}

grid: "" {
  grid-rows: 2
  grid-gap: 12
  style.stroke: transparent
  style.fill: transparent

  row1: /plan-project {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    d_doc: "01-design/\ndesign-01.md" {
      shape: page
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    slices: "02-slices/\n*.md\n(+status_updated_at)" {
      shape: page
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    brief: "03-briefs/\n*.md" {
      shape: page
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    tasks: "04-tasks/\n*.md" {
      shape: page
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }

    d_doc -> slices: slicing {
      style.font-size: 9
    }
    slices -> brief: spec {
      style.font-size: 9
    }
    brief -> tasks: breakdown {
      style.font-size: 9
    }
  }

  row2: "/implement + /review" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    code: "code changes\n(worktree)" {
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }
    qa_report: "05-qa/\nqa-report.md" {
      shape: page
      style.fill: ${colors.qa}
      style.stroke: ${colors.qa-border}
    }
    archive: "done/YYYY-MM/\n{id}/" {
      shape: package
      style.fill: ${colors.archive}
      style.stroke: ${colors.archive-border}
    }
    new_slice: "new slice\n(↻ back to slices)" {
      shape: page
      style.fill: ${colors.feedback}
      style.stroke: ${colors.feedback-border}
    }

    code -> qa_report: "QA (auto)" {
      style.font-size: 9
    }
    qa_report -> archive: "/review approve" {
      style.font-size: 9
    }
    qa_report -> new_slice: "/review feedback" {
      style.font-size: 9
    }
  }
}

grid.row1.tasks -> grid.row2.code: /implement {
  style.font-size: 9
}
