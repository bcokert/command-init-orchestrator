vars: {
  d2-config: {
    layout-engine: dagre
    pad: 0
  }
  colors: {
    design: "#e3f2fd"
    design-border: "#1976D2"
    impl: "#f5f5f5"
    impl-border: "#9e9e9e"
    qa: "#f3e5f5"
    qa-border: "#7B1FA2"
    archive: "#e8f5e9"
    archive-border: "#388E3C"
    lc: "#555555"
  }
}

grid: "" {
  grid-rows: 2
  grid-gap: 12
  style.stroke: transparent
  style.fill: transparent

  row1: "slice queue (tasks_ready, oldest first)" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    s1a: "project A\nslice 01" {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    s2a: "project B\nslice 01" {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    s3a: "project A\nslice 02" {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    s4a: "project C\nslice 01" {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }

    s1a -> s2a
    s2a -> s3a
    s3a -> s4a
  }

  row2: "/implement — one slice at a time" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    executor: executing {
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }
    qa_step: "QA (auto)" {
      style.fill: ${colors.qa}
      style.stroke: ${colors.qa-border}
    }
    signoff: "signoff_review\n(→ /review)" {
      style.fill: ${colors.archive}
      style.stroke: ${colors.archive-border}
    }

    executor -> qa_step
    qa_step -> signoff
  }
}

grid.row1.s1a -> grid.row2.executor: dequeue {
  style.font-size: 9
}
