vars: {
  d2-config: {
    layout-engine: dagre
    pad: 0
  }
  colors: {
    design: "#e3f2fd"
    design-border: "#1976D2"
    impl: "#f5f5f5"
    impl-border: "#9e9e9e"
    qa: "#f3e5f5"
    qa-border: "#7B1FA2"
    archive: "#e8f5e9"
    archive-border: "#388E3C"
    feedback: "#fff3e0"
    feedback-border: "#FF9800"
    lc: "#555555"
  }
}

grid: "" {
  grid-rows: 3
  grid-gap: 12
  style.stroke: transparent
  style.fill: transparent

  row1: "project A" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    imp_a: /implement {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    wt_a: "worktree A\n(branch project/A)" {
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }
    tasks_a: implementing {
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }

    imp_a -> wt_a
    wt_a -> tasks_a
  }

  row2: "project B" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    imp_b: /implement {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    wt_b: "worktree B\n(branch project/B)" {
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }
    tasks_b: implementing {
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }

    imp_b -> wt_b
    wt_b -> tasks_b
  }

  row3: "both visible" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    status: /status {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    table: "project A — implementing\nproject B — implementing\n(main branch untouched)" {
      shape: page
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }

    status -> table
  }
}
