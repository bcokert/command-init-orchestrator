vars: {
  d2-config: {
    layout-engine: dagre
    pad: 0
  }
  colors: {
    design: "#e3f2fd"
    design-border: "#1976D2"
    impl: "#f5f5f5"
    impl-border: "#9e9e9e"
    qa: "#f3e5f5"
    qa-border: "#7B1FA2"
    archive: "#e8f5e9"
    archive-border: "#388E3C"
    feedback: "#fff3e0"
    feedback-border: "#FF9800"
    lc: "#555555"
  }
}

grid: "" {
  grid-rows: 2
  grid-gap: 12
  style.stroke: transparent
  style.fill: transparent

  row1: "feedback path" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    review: "/review" {
      shape: diamond
      width: 90
      height: 90
      style.fill: ${colors.qa}
      style.stroke: ${colors.qa-border}
      style.font-size: 11
    }
    new_slice: "draft follow-up\nfollow_up_of: NN\n(e.g. 5.1)" {
      shape: page
      style.fill: ${colors.feedback}
      style.stroke: ${colors.feedback-border}
    }
    design: /plan-project {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    spec: "spec +\nbreakdown" {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }

    review -> new_slice: "feedback\n(batch continues)" {
      style.font-size: 9
    }
    new_slice -> design: "run /plan-project\nlater" {
      style.font-size: 9
    }
    design -> spec
  }

  row2: "back to review" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    impl: /implement {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    qa: "QA (auto)" {
      style.fill: ${colors.qa}
      style.stroke: ${colors.qa-border}
    }
    review2: "/review\n(↻ loop)" {
      shape: diamond
      width: 90
      height: 90
      style.fill: ${colors.qa}
      style.stroke: ${colors.qa-border}
      style.font-size: 11
    }

    impl -> qa
    qa -> review2
  }
}

grid.row1.spec -> grid.row2.impl: /implement {
  style.font-size: 9
}

batch_note: "/review iterates every signoff slice in the project.\nFeedback creates a draft follow-up and continues to the next slice — no pause." {
  style.fill: "#fafafa"
  style.stroke: "#cccccc"
  style.font-size: 10
  style.font-color: ${colors.lc}
}
