vars: {
  d2-config: {
    layout-engine: dagre
  }
  colors: {
    design: "#e3f2fd"
    design-border: "#1976D2"
    impl: "#f5f5f5"
    impl-border: "#9e9e9e"
    qa: "#f3e5f5"
    qa-border: "#7B1FA2"
    archive: "#e8f5e9"
    archive-border: "#388E3C"
    feedback: "#fff3e0"
    feedback-border: "#FF9800"
    lc: "#555555"
  }
}

grid: "" {
  grid-rows: 2
  grid-gap: 12
  style.stroke: transparent
  style.fill: transparent

  row1: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    review: "/review" {
      shape: diamond
      width: 90
      height: 90
      style.fill: ${colors.qa}
      style.stroke: ${colors.qa-border}
      style.font-size: 11
    }
    new_slice: "new slice\nadded to backlog" {
      shape: page
      style.fill: ${colors.feedback}
      style.stroke: ${colors.feedback-border}
    }
    design: /plan-project {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    spec: "spec +\nbreakdown" {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    _lbl: feedback path {
      shape: text
      style.font-size: 11
      style.bold: true
      style.font-color: ${colors.lc}
    }

    review -> new_slice: feedback
    new_slice -> design: run /plan-project
    design -> spec
    spec -> _lbl { style.stroke-width: 0 }
  }

  row2: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    impl: /implement {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    qa: "QA (auto)" {
      style.fill: ${colors.qa}
      style.stroke: ${colors.qa-border}
    }
    review2: "/review\n(↻ loop)" {
      shape: diamond
      width: 90
      height: 90
      style.fill: ${colors.qa}
      style.stroke: ${colors.qa-border}
      style.font-size: 11
    }
    _lbl: back to review {
      shape: text
      style.font-size: 11
      style.bold: true
      style.font-color: ${colors.lc}
    }

    impl -> qa
    qa -> review2
    review2 -> _lbl { style.stroke-width: 0 }
  }
}

grid.row1.spec -> grid.row2.impl: /implement
