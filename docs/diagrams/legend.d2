vars: {
  d2-config: {
    layout-engine: dagre
    pad: 0
  }
  colors: {
    design: "#e3f2fd"
    design-border: "#1976D2"
    impl: "#f5f5f5"
    impl-border: "#9e9e9e"
    qa: "#f3e5f5"
    qa-border: "#7B1FA2"
    archive: "#e8f5e9"
    archive-border: "#388E3C"
    feedback: "#fff3e0"
    feedback-border: "#FF9800"
    gate: "#e8f4f8"
    gate-border: "#2196F3"
    lc: "#555555"
  }
}

legend: "" {
  direction: right
  style.fill: transparent
  style.stroke: transparent

  auto: "automated step" {
    style.fill: ${colors.impl}
    style.stroke: ${colors.impl-border}
    style.font-size: 11
  }
  plan: "planning artifact" {
    style.fill: ${colors.design}
    style.stroke: ${colors.design-border}
    style.font-size: 11
  }
  gate: "human review gate" {
    shape: diamond
    width: 120
    height: 60
    style.fill: ${colors.gate}
    style.stroke: ${colors.gate-border}
    style.stroke-width: 3
    style.font-size: 11
  }
  qa: "QA step" {
    style.fill: ${colors.qa}
    style.stroke: ${colors.qa-border}
    style.font-size: 11
  }
  done: "done / archived" {
    style.fill: ${colors.archive}
    style.stroke: ${colors.archive-border}
    style.font-size: 11
  }
  feedback: "feedback / pending" {
    style.fill: ${colors.feedback}
    style.stroke: ${colors.feedback-border}
    style.font-size: 11
  }
}
