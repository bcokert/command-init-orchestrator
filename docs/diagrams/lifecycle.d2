vars: {
  d2-config: {
    layout-engine: dagre
    pad: 0
  }
  colors: {
    gate: "#e8f4f8"
    gate-border: "#2196F3"
    auto: "#f5f5f5"
    auto-border: "#9e9e9e"
    terminal: "#e8f5e9"
    terminal-border: "#4caf50"
    feedback: "#fff3e0"
    feedback-border: "#ff9800"
    lc: "#555555"
  }
}

grid: "" {
  grid-rows: 3
  grid-gap: 8
  style.stroke: transparent
  style.fill: transparent

  row1: "/plan-project — design + slicing" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    d_ip: design_in_progress {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    d_rv: design_review {
      shape: diamond
      width: 100
      height: 100
      style.fill: ${colors.gate}
      style.stroke: ${colors.gate-border}
      style.stroke-width: 3
      style.font-size: 11
    }
    s_ip: slicing_in_progress {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    s_rv: slicing_review {
      shape: diamond
      width: 100
      height: 100
      style.fill: ${colors.gate}
      style.stroke: ${colors.gate-border}
      style.stroke-width: 3
      style.font-size: 11
    }

    d_ip -> d_rv: /plan-project {
      style.font-size: 9
    }
    d_rv -> s_ip: /plan-project {
      style.font-size: 9
    }
    s_ip -> s_rv: /plan-project {
      style.font-size: 9
    }
    d_rv -> d_rv: "edit + retry" {
      style.stroke: "#FF9800"
      style.font-size: 9
    }
    s_rv -> s_rv: "edit + retry" {
      style.stroke: "#FF9800"
      style.font-size: 9
    }
  }

  row2: "/plan-project — spec + breakdown (auto, no gate)" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    speccing: speccing {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    bkdn: breakdown {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    tr: tasks_ready {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }

    speccing -> bkdn: /plan-project {
      style.font-size: 9
    }
    bkdn -> tr: /plan-project {
      style.font-size: 9
    }
  }

  row3: "/implement + /review" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"
    style.font-size: 11
    style.bold: true
    style.font-color: ${colors.lc}

    impl: implementing {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    qa_ip: qa_in_progress {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    sg_rv: signoff_review {
      shape: diamond
      width: 100
      height: 100
      style.fill: ${colors.gate}
      style.stroke: ${colors.gate-border}
      style.stroke-width: 3
      style.font-size: 11
    }
    done: done {
      style.fill: ${colors.terminal}
      style.stroke: ${colors.terminal-border}
    }
    fb: "follow_up_of: draft\n(↻ /plan-project)" {
      style.fill: ${colors.feedback}
      style.stroke: ${colors.feedback-border}
    }

    impl -> qa_ip: "/implement (QA start)" {
      style.font-size: 9
    }
    qa_ip -> sg_rv: "/implement (QA pass)" {
      style.font-size: 9
    }
    sg_rv -> done: "/review approve" {
      style.font-size: 9
    }
    sg_rv -> fb: "/review feedback" {
      style.font-size: 9
    }
  }
}

grid.row1.s_rv -> grid.row2.speccing: /plan-project {
  style.font-size: 9
}
grid.row2.tr -> grid.row3.impl: /implement {
  style.font-size: 9
}
