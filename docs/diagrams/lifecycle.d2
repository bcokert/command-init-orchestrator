vars: {
  d2-config: {
    layout-engine: dagre
  }
  colors: {
    gate: "#e8f4f8"
    gate-border: "#2196F3"
    auto: "#f5f5f5"
    auto-border: "#9e9e9e"
    terminal: "#e8f5e9"
    terminal-border: "#4caf50"
    feedback: "#fff3e0"
    feedback-border: "#ff9800"
    lc: "#555555"
  }
}

grid: "" {
  grid-rows: 3
  grid-gap: 8
  style.stroke: transparent
  style.fill: transparent

  row1: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    d_ip: design_in_progress {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    d_rv: design_review {
      shape: diamond
      width: 100
      height: 100
      style.fill: ${colors.gate}
      style.stroke: ${colors.gate-border}
      style.stroke-width: 3
      style.font-size: 11
    }
    s_ip: slicing_in_progress {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    s_rv: slicing_review {
      shape: diamond
      width: 100
      height: 100
      style.fill: ${colors.gate}
      style.stroke: ${colors.gate-border}
      style.stroke-width: 3
      style.font-size: 11
    }
    _lbl: /design — design + slicing {
      shape: text
      style.font-size: 10
      style.bold: true
      style.font-color: ${colors.lc}
    }

    d_ip -> d_rv: /design
    d_rv -> s_ip: /design
    s_ip -> s_rv: /design
    d_rv -> d_rv: edit + retry {
      style.stroke: "#FF9800"
      style.font-size: 10
    }
    s_rv -> s_rv: edit + retry {
      style.stroke: "#FF9800"
      style.font-size: 10
    }
    s_rv -> _lbl { style.stroke-width: 0 }
  }

  row2: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    p_ip: spec_in_progress {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    p_rv: spec_review {
      shape: diamond
      width: 100
      height: 100
      style.fill: ${colors.gate}
      style.stroke: ${colors.gate-border}
      style.stroke-width: 3
      style.font-size: 11
    }
    b_ip: breakdown_in_progress {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    tr: tasks_ready {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    _lbl: /design — spec + breakdown {
      shape: text
      style.font-size: 10
      style.bold: true
      style.font-color: ${colors.lc}
    }

    p_ip -> p_rv: /design
    p_rv -> b_ip: /design
    b_ip -> tr: /design
    p_rv -> p_rv: edit + retry {
      style.stroke: "#FF9800"
      style.font-size: 10
    }
    tr -> _lbl { style.stroke-width: 0 }
  }

  row3: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    impl: implementing {
      style.fill: ${colors.auto}
      style.stroke: ${colors.auto-border}
    }
    sg_rv: signoff_review {
      shape: diamond
      width: 100
      height: 100
      style.fill: ${colors.gate}
      style.stroke: ${colors.gate-border}
      style.stroke-width: 3
      style.font-size: 11
    }
    done: done {
      style.fill: ${colors.terminal}
      style.stroke: ${colors.terminal-border}
    }
    fb: "feedback_pending\n(↻ /design)" {
      style.fill: ${colors.feedback}
      style.stroke: ${colors.feedback-border}
    }
    _lbl: /implement + /review {
      shape: text
      style.font-size: 10
      style.bold: true
      style.font-color: ${colors.lc}
    }

    impl -> sg_rv: /implement (QA pass)
    sg_rv -> done: /review approve
    sg_rv -> fb: /review feedback
    fb -> _lbl { style.stroke-width: 0 }
  }
}

grid.row1.s_rv -> grid.row2.p_ip: /design
grid.row2.tr -> grid.row3.impl: /implement
