vars: {
  d2-config: {
    layout-engine: dagre
  }
  colors: {
    design: "#e3f2fd"
    design-border: "#1976D2"
    impl: "#f5f5f5"
    impl-border: "#9e9e9e"
    qa: "#f3e5f5"
    qa-border: "#7B1FA2"
    archive: "#e8f5e9"
    archive-border: "#388E3C"
    feedback: "#fff3e0"
    feedback-border: "#FF9800"
    lc: "#555555"
  }
}

grid: "" {
  grid-rows: 3
  grid-gap: 12
  style.stroke: transparent
  style.fill: transparent

  row1: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    s1_design: "design +\nspec + tasks" {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    s1_impl: implementing {
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }
    s1_review: "/review\napprove" {
      shape: diamond
      width: 90
      height: 90
      style.fill: ${colors.archive}
      style.stroke: ${colors.archive-border}
      style.font-size: 11
    }
    s1_done: "archived" {
      style.fill: ${colors.archive}
      style.stroke: ${colors.archive-border}
    }
    _lbl: "slice 01 (done)" {
      shape: text
      style.font-size: 11
      style.bold: true
      style.font-color: ${colors.lc}
    }

    s1_design -> s1_impl
    s1_impl -> s1_review
    s1_review -> s1_done: approve
    s1_done -> _lbl { style.stroke-width: 0 }
  }

  row2: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    s2_design: "design +\nspec + tasks\n(detailed now)" {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    s2_impl: implementing {
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }
    s2_review: "/review\napprove" {
      shape: diamond
      width: 90
      height: 90
      style.fill: ${colors.archive}
      style.stroke: ${colors.archive-border}
      style.font-size: 11
    }
    s2_done: "archived" {
      style.fill: ${colors.archive}
      style.stroke: ${colors.archive-border}
    }
    _lbl: "slice 02 (current)" {
      shape: text
      style.font-size: 11
      style.bold: true
      style.font-color: ${colors.lc}
    }

    s2_design -> s2_impl
    s2_impl -> s2_review
    s2_review -> s2_done: approve
    s2_done -> _lbl { style.stroke-width: 0 }
  }

  row3: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    s3_rough: "rough draft\n(stays rough\nuntil slice 02\nis done)" {
      style.fill: ${colors.feedback}
      style.stroke: ${colors.feedback-border}
    }
    s3_next: "detailed when\nslice 02 done" {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    _lbl: "slice 03+ (backlog)" {
      shape: text
      style.font-size: 11
      style.bold: true
      style.font-color: ${colors.lc}
    }

    s3_rough -> s3_next: becomes next
    s3_next -> _lbl { style.stroke-width: 0 }
  }
}

grid.row1.s1_review -> grid.row2.s2_design: slice 02 becomes next
grid.row2.s2_review -> grid.row3.s3_next: slice 03 becomes next
