vars: {
  d2-config: {
    layout-engine: dagre
  }
  colors: {
    design: "#e3f2fd"
    design-border: "#1976D2"
    impl: "#f5f5f5"
    impl-border: "#9e9e9e"
    qa: "#f3e5f5"
    qa-border: "#7B1FA2"
    archive: "#e8f5e9"
    archive-border: "#388E3C"
    feedback: "#fff3e0"
    feedback-border: "#FF9800"
    lc: "#555555"
  }
}

grid: "" {
  grid-rows: 2
  grid-gap: 12
  style.stroke: transparent
  style.fill: transparent

  row1: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    t1: "task 1\n(done)" {
      style.fill: ${colors.archive}
      style.stroke: ${colors.archive-border}
    }
    t2: "task 2\n(done)" {
      style.fill: ${colors.archive}
      style.stroke: ${colors.archive-border}
    }
    stop: "session ends" {
      shape: oval
      style.fill: ${colors.feedback}
      style.stroke: ${colors.feedback-border}
    }
    _lbl: first run {
      shape: text
      style.font-size: 11
      style.bold: true
      style.font-color: ${colors.lc}
    }

    t1 -> t2
    t2 -> stop
    stop -> _lbl { style.stroke-width: 0 }
  }

  row2: "" {
    direction: right
    style.fill: "#fafafa"
    style.stroke: "#dddddd"

    rerun: /implement {
      style.fill: ${colors.design}
      style.stroke: ${colors.design-border}
    }
    t3: task 3 {
      style.fill: ${colors.impl}
      style.stroke: ${colors.impl-border}
    }
    qa: "QA (auto)" {
      style.fill: ${colors.qa}
      style.stroke: ${colors.qa-border}
    }
    signoff: signoff_review {
      style.fill: ${colors.archive}
      style.stroke: ${colors.archive-border}
    }
    _lbl: re-run {
      shape: text
      style.font-size: 11
      style.bold: true
      style.font-color: ${colors.lc}
    }

    rerun -> t3: picks up here
    t3 -> qa
    qa -> signoff
    signoff -> _lbl { style.stroke-width: 0 }
  }
}
